# The public hostname. Its DNS must point at this machine, with ports 80 and 443 open,
# so Caddy can get a certificate. For a quick local try, use DOMAIN=localhost
# (Caddy's own CA; the browser will warn).
DOMAIN=schedule.example.com
# Image tag to run: latest (the most recent release), or pin one such as v0.4.2.
TAG=latest
