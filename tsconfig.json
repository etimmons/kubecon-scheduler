{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["node", "vite/client", "vite-plugin-pwa/client"],
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["shared", "scraper", "server", "app", "scripts/build-static.ts", "e2e", "playwright.config.ts", "vitest.config.ts"]
}
