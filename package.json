{
  "name": "kubecon-scheduler",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Offline-capable KubeCon schedule PWA with combined filters and a synced personal agenda",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "vite build --config app/vite.config.ts",
    "scrape": "node scraper/src/cli.ts",
    "start": "node server/src/main.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
